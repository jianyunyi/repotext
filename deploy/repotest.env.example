# Copy to /etc/repotest/repotest.env and keep mode 0600.
REPOTEST_DB=/var/lib/repotest/repotest.db
REPOTEST_WORK_DIR=/var/lib/repotest/work
REPOTEST_ADDR=127.0.0.1:8080
REPOTEST_LAN_ADDR=
REPOTEST_RUNNER_ENABLED=0
REPOTEST_AC008_ACCEPTED=0
# Set only after S4 evidence is accepted and the image digest is local.
# REPOTEST_GO_IMAGE=sha256:<64 lowercase hex characters>
